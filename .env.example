# Copy to .env and fill in (real .env is git-ignored).
EGYM_USERNAME=you@example.com
EGYM_PASSWORD=your-egym-password

# Email notifications not needed — YMCA sends booking confirmations from noreply@ymcasv.org.
# Run results appear in the GitHub Actions job log.

# For scripts/setup_cronjob_org.sh (creates the cron-job.org triggers):
# CRONJOB_ORG_API_KEY=   # cron-job.org -> Settings -> API
# GITHUB_PAT=            # fine-grained token, your code repo only, Actions: Read and write
